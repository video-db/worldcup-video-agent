# Local application configuration
DATABASE_URL=postgres://user:password@localhost:5432/worldcup_video_agent
OPEN_ROUTER_API_KEY=replace-with-your-openrouter-key
ENCRYPTION_SECRET=replace-with-a-32-byte-hex-secret
ADMIN_SECRET=replace-with-an-admin-secret
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Local self-hosted Inngest development only. Do not point local development at
# Inngest Cloud. Production values are documented in README.md.
INNGEST_MODE=self-hosted
INNGEST_DEV=1
INNGEST_BASE_URL=http://localhost:8288
INNGEST_SERVE_ORIGIN=http://localhost:3000
INNGEST_SERVE_PATH=/api/inngest
INNGEST_WORKFLOW_CONCURRENCY=2

# Production only: use the Azure event/signing keys. The signing key must be
# at least 64 hexadecimal characters; never set INNGEST_SIGNING_KEY_FALLBACK.
# INNGEST_EVENT_KEY=replace-with-the-azure-event-key
# INNGEST_SIGNING_KEY=replace-with-at-least-64-hex-characters
